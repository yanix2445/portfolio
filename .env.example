# Clé API Resend (serveur uniquement) pour envoyer le mail du formulaire de contact
RESEND_API_KEY=
# Clé secrète Cloudflare Turnstile (serveur uniquement) pour la vérification siteverify
TURNSTILE_SECRET_KEY=
# Clé de site Cloudflare Turnstile, exposée au client pour afficher le widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Adresse de destination des messages du formulaire de contact (serveur uniquement)
CONTACT_TO_EMAIL=
# Facultatif : expéditeur des messages. Par défaut "Portfolio <contact@yanis-harrat.com>",
# sur le domaine vérifié chez Resend. Pour tester avec un autre compte Resend :
# "Portfolio <onboarding@resend.dev>" (Resend n'envoie alors qu'à l'adresse du compte).
CONTACT_FROM_EMAIL=

# /contact n'affiche le formulaire que si les quatre variables ci-dessus (hors CONTACT_FROM_EMAIL)
# sont renseignées. La page est prérendue : redéployer après les avoir saisies.
# Clés de test Turnstile (publiques, documentées par Cloudflare) pour le développement :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA  (widget toujours valide)
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA (vérification toujours réussie)
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA (vérification toujours refusée)
